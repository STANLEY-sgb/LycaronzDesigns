# ─── Database (Supabase Postgres) ─────────────────────────────────────────────
# Transaction pooler, port 6543. Used by the live site on Vercel.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
# Session pooler, port 5432. Used only by Prisma migrations. Do not use db.PROJECT.supabase.co (often IPv6-only, which Vercel cannot reach).
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# Auth.js on Vercel
AUTH_TRUST_HOST="true"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
AUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3001"
AUTH_URL="http://localhost:3001"

# ─── Vercel Blob Storage (production file uploads) ───────────────────────────
BLOB_READ_WRITE_TOKEN="your-vercel-blob-token"

# ─── Cloudinary Storage (production image/video uploads) ────────────────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ─── WhatsApp ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER="256700000000"

# ─── Admin Account (seeding only) ─────────────────────────────────────────────
ADMIN_EMAIL="admin@lycaronzdesigns.com"
ADMIN_PASSWORD="ChangeThisPassword123!"

# ─── Email Notification System ────────────────────────────────────────────────
# Provider: Gmail SMTP with App Password
#
# Setup instructions:
#   1. Sign into the Google account for info.lycaronz@gmail.com
#   2. Enable 2-Step Verification:
#      myaccount.google.com → Security → 2-Step Verification
#   3. Create an App Password:
#      myaccount.google.com → Security → App Passwords
#      Select "Mail" and your device, then copy the 16-character password
#   4. Paste that password as SMTP_PASS below (no spaces)
#
# Alternative providers (if not using Gmail):
#   Brevo (formerly Sendinblue): free tier, reliable
#   Mailgun: developer-friendly, free tier
#   Amazon SES: production scale

SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="info.lycaronz@gmail.com"
SMTP_PASS="your-16-character-app-password"

# Destination for ALL business notifications
EMAIL_TO="info.lycaronz@gmail.com"

# Sender identity shown in email clients (must match SMTP_USER for Gmail)
EMAIL_FROM="LYCARONZ DESIGNS <info.lycaronz@gmail.com>"
