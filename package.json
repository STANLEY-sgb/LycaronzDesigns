  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/ensure-prisma-provider.mjs && prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "node scripts/ensure-prisma-provider.mjs && prisma generate",
    "prisma:migrate": "prisma migrate dev",
