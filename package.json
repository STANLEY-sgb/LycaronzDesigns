    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "framer-motion": "^10.16.16",
    "jsonwebtoken": "^9.0.0",
    "lucide-react": "^1.14.0",
    "next": "^16.3.6",
    "next-auth": "^1.12.1",
    "next-cloudinary": "^6.19.3",
    "nodemailer": "^7.0.13",
    "pg": "^8.23.0",
    "prisma": "^5.7.1",
